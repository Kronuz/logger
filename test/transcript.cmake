# Runs the transcript built against the library and the one built against the frozen old
# implementation, and fails unless their outputs are identical, byte for byte.
#   cmake -DNEW=<exe> -DOLD=<exe> -DDIR=<scratch dir> -P transcript.cmake
file(MAKE_DIRECTORY "${DIR}")
foreach(which NEW OLD)
  execute_process(COMMAND "${${which}}" OUTPUT_FILE "${DIR}/transcript_${which}.txt" ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${which} transcript failed (${rc}): ${err}")
  endif()
endforeach()
file(SIZE "${DIR}/transcript_NEW.txt" size)
if(size LESS 5000)
  message(FATAL_ERROR "the transcript is only ${size} bytes: the script did not run")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${DIR}/transcript_NEW.txt" "${DIR}/transcript_OLD.txt" RESULT_VARIABLE same)
if(NOT same EQUAL 0)
  execute_process(COMMAND diff -u "${DIR}/transcript_OLD.txt" "${DIR}/transcript_NEW.txt" OUTPUT_VARIABLE d)
  string(SUBSTRING "${d}" 0 6000 d)
  message(FATAL_ERROR "the logger writes different bytes than the frozen old implementation:\n${d}")
endif()
message(STATUS "transcript identical (${size} bytes)")
